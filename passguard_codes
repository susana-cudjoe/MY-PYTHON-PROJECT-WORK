# Section 2: Generate a password
gen_frame = tk.LabelFrame(root, text=" 2. Generate a strong password ", padx=10, pady=10)
gen_frame.pack(fill="x", padx=15, pady=5)
tk.Label(gen_frame, text="Length:").pack(side="left")
