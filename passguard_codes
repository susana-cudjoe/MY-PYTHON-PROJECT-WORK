import hashlib
import secrets
import string
import re
from datetime import datetime
import tkinter as tk
from tkinter import messagebox, ttk

LOG_FILE = "passguard_log.txt"
COMMON_PASSWORDS = {
    "123456", "password", "123456789", "12345678", "12345",
    "qwerty", "abc123", "111111", "123123", "admin",
    "letmein", "welcome", "iloveyou", "monkey", "football",
    "password1", "000000", "ghana123", "accra123", "god123",
}
COLOURS = {
    "VERY WEAK": "#b71c1c",
    "WEAK": "#e53935",
    "MEDIUM": "#fb8c00",
    "STRONG": "#2e7d32",
}


def check_strength(password, your_name=""):
    """Return (score, label, tips) for a password. The score is out of 6."""
    if password.casefold() in COMMON_PASSWORDS:
        tips = ["This is one of the most common passwords. Never use it."]
        if your_name.strip() and your_name.strip().casefold() in password.casefold():
            tips.append("Your password contains your name. Choose a password without personal information.")
        return 0, "VERY WEAK", tips

    score = 0
    tips = []

    if len(password) >= 12:
        score += 2
    elif len(password) >= 8:
        score += 1
        tips.append("Use 12 or more characters for extra strength.")
    else:
        tips.append("Too short. Use at least 8 characters (12+ is better).")

    if any(char.isupper() for char in password):
        score += 1
    else:
        tips.append("Add an uppercase letter (A-Z).")

    if any(char.islower() for char in password):
        score += 1
    else:
        tips.append("Add a lowercase letter (a-z).")

    if any(char.isdigit() for char in password):
        score += 1
    else:
        tips.append("Add a number (0-9).")

    if any(char in string.punctuation for char in password):
        score += 1
    else:
        tips.append("Add a symbol such as ! @ # $ %.")

    if re.search(r"(.)\1\1", password):
        score = max(0, score - 1)
        tips.append("Avoid three identical characters in a row (for example, 111).")

    if your_name.strip() and your_name.strip().casefold() in password.casefold():
        tips.append("Your password contains your name. Choose a password without personal information.")

    if score <= 2:
        label = "WEAK"
    elif score <= 4:
        label = "MEDIUM"
    else:
        label = "STRONG"

    return score, label, tips


def generate_password(length=16):
    """Generate a random password that scores STRONG in this checker."""
    length = max(8, int(length))
    alphabet = string.ascii_letters + string.digits + string.punctuation

    while True:
        password = "".join(secrets.choice(alphabet) for _ in range(length))
        _, label, _ = check_strength(password)
        if label == "STRONG":
            return password


def hash_password(password):
    """Return the SHA-256 hash of a password as hexadecimal text."""
    return hashlib.sha256(password.encode("utf-8")).hexdigest()


def save_to_log(password, score, label):
    """Save a check using a shortened hash; the password itself is not logged."""
    time_now = datetime.now().strftime("%Y-%m-%d %H:%M")
    short_hash = hash_password(password)[:10]
    record = f"{time_now} | {short_hash}... | {score}/6 | {label}"
    with open(LOG_FILE, "a", encoding="utf-8") as log_file:
        log_file.write(record + "\n")
    return record


def load_log():
    """Return saved records, or an empty list if the log does not exist."""
    try:
        with open(LOG_FILE, "r", encoding="utf-8") as log_file:
            return [line.strip() for line in log_file if line.strip()]
    except FileNotFoundError:
        return []


# GUI event handlers

def live_check(event=None):
    """Update the strength bar and tips as the user types."""
    password = password_entry.get()
    if not password:
        strength_bar["value"] = 0
        result_label.config(text="Start typing a password...", fg="grey")
        tips_label.config(text="")
        return

    score, label, tips = check_strength(password, name_entry.get())
    strength_bar["value"] = score
    result_label.config(text=f"{label}  ({score}/6)", fg=COLOURS[label])
    tips_label.config(text="\n".join("- " + tip for tip in tips))


def on_check():
    password = password_entry.get()
    if not password:
        messagebox.showwarning("PassGuard", "Please type a password first.")
        return

    score, label, _ = check_strength(password, name_entry.get())
    try:
        record = save_to_log(password, score, label)
    except OSError as error:
        messagebox.showerror("PassGuard", f"Could not save the check:\n{error}")
        return

    history_list.insert(tk.END, record)
    messagebox.showinfo("PassGuard", f"Result: {label} ({score}/6)\nSaved to history.")


def toggle_show():
    password_entry.config(show="" if show_var.get() else "*")


def on_generate():
    try:
        length = int(length_var.get())
    except (tk.TclError, ValueError):
        messagebox.showwarning("PassGuard", "Choose a valid password length.")
        return
    generated_var.set(generate_password(length))


def on_copy():
    password = generated_var.get()
    if not password:
        messagebox.showwarning("PassGuard", "Generate a password first.")
        return
    root.clipboard_clear()
    root.clipboard_append(password)
    messagebox.showinfo("PassGuard", "Password copied to clipboard.")


def use_generated():
    password = generated_var.get()
    if not password:
        messagebox.showwarning("PassGuard", "Generate a password first.")
        return
    password_var.set(password)
    live_check()


def clear_history():
    if not messagebox.askyesno("Clear history", "Are you sure you want to clear all password check history?"):
        return
    try:
        with open(LOG_FILE, "w", encoding="utf-8"):
            pass
    except OSError as error:
        messagebox.showerror("PassGuard", f"Could not clear history:\n{error}")
        return
    history_list.delete(0, tk.END)


def open_login_simulator():
    window = tk.Toplevel(root)
    window.title("PassGuard - Login simulator")
    window.geometry("360x230")
    window.resizable(False, False)
    tk.Label(window, text="Register or log in", font=("Segoe UI", 14, "bold")).pack(pady=10)
    tk.Label(window, text="Username").pack(anchor="w", padx=20)
    username = tk.Entry(window)
    username.pack(fill="x", padx=20)
    tk.Label(window, text="Password").pack(anchor="w", padx=20, pady=(8, 0))
    login_password = tk.Entry(window, show="*")
    login_password.pack(fill="x", padx=20)
    registered_users = {}

    def register():
        user, password = username.get().strip(), login_password.get()
        if not user or not password:
            messagebox.showwarning("PassGuard", "Enter a username and password.", parent=window)
            return
        if user in registered_users:
            messagebox.showwarning("PassGuard", "That username is already registered.", parent=window)
            return
        registered_users[user] = hash_password(password)
        login_password.delete(0, tk.END)
        messagebox.showinfo("PassGuard", "Account registered. Log in with your credentials.", parent=window)

    def login():
        user, password = username.get().strip(), login_password.get()
        saved_hash = registered_users.get(user)
        if saved_hash and saved_hash == hash_password(password):
            messagebox.showinfo("PassGuard", f"Welcome, {user}! Login successful.", parent=window)
        else:
            messagebox.showerror("PassGuard", "Invalid username or password.", parent=window)

    row = tk.Frame(window)
    row.pack(pady=12)
    tk.Button(row, text="Register", command=register).pack(side="left", padx=5)
    tk.Button(row, text="Log in", command=login).pack(side="left", padx=5)


def on_hash():
    password = password_entry.get()
    if not password:
        messagebox.showwarning("PassGuard", "Please type a password first.")
        return
    hash_var.set(hash_password(password))


def toggle_dark_mode():
    dark = dark_var.get()
    bg, fg = ("#222222", "#f1f1f1") if dark else ("#f0f0f0", "#111111")
    entry_bg = "#383838" if dark else "white"
    root.config(bg=bg)
    for widget in root.winfo_children():
        apply_theme(widget, bg, fg, entry_bg)


def apply_theme(widget, bg, fg, entry_bg):
    options = widget.configure()
    if "bg" in options:
        widget.config(bg=bg)
    if "fg" in options:
        widget.config(fg=fg)
    if isinstance(widget, (tk.Entry, tk.Listbox)):
        widget.config(bg=entry_bg, fg=fg, insertbackground=fg)
    if isinstance(widget, tk.Button):
        widget.config(bg="#444444" if dark_var.get() else "#e1e1e1", fg=fg,
                     activebackground="#555555" if dark_var.get() else "#d5d5d5")
    for child in widget.winfo_children():
        apply_theme(child, bg, fg, entry_bg)


