tk.Spinbox(gen_frame, from_=8, to=32, width=4, textvariable=length_var, state="readonly").pack(side="left", padx=5)
tk.Button(gen_frame, text="Generate", command=on_generate).pack(side="left", padx=5)
generated_var = tk.StringVar()
tk.Entry(gen_frame, textvariable=generated_var, state="readonly", font=("Consolas", 11), width=22).pack(side="left", padx=5)
tk.Button(gen_frame, text="Copy", command=on_copy).pack(side="left")
tk.Button(gen_frame, text="Use generated", command=use_generated).pack(side="left", padx=5)

# Section 3: History
hist_frame = tk.LabelFrame(root, text=" 3. Check history (hashes only) ", padx=10, pady=10)
hist_frame.pack(fill="both", expand=True, padx=15, pady=5)
history_list = tk.Listbox(hist_frame, font=("Consolas", 9), height=8)
history_list.pack(fill="both", expand=True)
for saved_record in load_log():
    history_list.insert(tk.END, saved_record)

footer = tk.Frame(root)
footer.pack(fill="x", padx=15, pady=(2, 10))
tk.Button(footer, text="Clear history", command=clear_history).pack(side="left")
tk.Button(footer, text="Login simulator", command=open_login_simulator).pack(side="left", padx=6)
dark_var = tk.BooleanVar(value=False)
tk.Checkbutton(footer, text="Dark mode", variable=dark_var, command=toggle_dark_mode).pack(side="right")

root.mainloop()
